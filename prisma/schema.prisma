generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Lead {
  id           String    @id @default(cuid())
  nome         String
  email        String
  telefone     String?
  tipoDecl     String?
  servico      String    @default("IRPF") // IRPF | MEI | GERAL
  origem       String    @default("organico")
  status       String    @default("novo")
  mensagem     String?
  emailSeqStep Int       @default(0)
  emailSeqAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([email])
  @@index([status])
  @@index([createdAt])
  @@index([emailSeqStep])
  @@index([servico])
  @@map("leads")
}

model BlogPost {
  id               String         @id @default(cuid())
  title            String
  slug             String         @unique
  summary          String?
  content          String
  faqsJson         String         @default("[]")
  reviewJson       String         @default("") @map("review_json")
  aiModel          String         @default("") @map("ai_model")
  tags             String[]
  coverImage       String?
  imageAlt         String         @default("") @map("image_alt")
  imageAttribution String?  @map("image_attribution")
  published        Boolean        @default(false)
  hiddenFromBlogList Boolean      @default(false) @map("hidden_from_blog_list")
  metaTitle        String?
  metaDesc         String?
  keywords         String[]
  views            Int            @default(0)
  readTime         Int            @default(5)
  categoria        String         @default("IRPF") // IRPF | MEI | DESENROLA | GERAL
  postType         String?        @map("post_type") // traffic | lead
  audience         String?
  searchIntent     String?        @map("search_intent")
  factScore        Int?           @map("fact_score")
  riskScore        Int?           @map("risk_score")
  needsReview      Boolean        @default(false) @map("needs_review")
  campaignMode     String?        @map("campaign_mode")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  trendKeywords    TrendKeyword[]

  @@index([slug])
  @@index([published, createdAt])
  @@index([categoria, published])
  @@map("blog_posts")
}

model TrendKeyword {
  id                 String    @id @default(cuid())
  keyword            String
  source             String // serpapi_trends | serpapi_related | serpapi_interest | rss_fallback | evergreen
  category           String // IRPF | IRPF_ATRASADO | CPF | MEI | DASN | PARCELAMENTO_MEI | FINANCAS
  audience           String?
  intent             String?
  postType           String?   @map("post_type") // traffic | lead
  trendScore         Int?      @map("trend_score")
  businessScore      Int?      @map("business_score")
  urgencyScore       Int?      @map("urgency_score")
  seoScore           Int?      @map("seo_score")
  riskScore          Int?      @map("risk_score")
  breakoutStatus     Boolean   @default(false) @map("breakout_status")
  geo                String    @default("BR")
  relatedQueriesJson String?   @map("related_queries_json")
  cachedUntil        DateTime  @map("cached_until")
  usedInPostId       String?   @map("used_in_post_id")
  rawPayload         String?   @map("raw_payload") @db.Text
  createdAt          DateTime  @default(now()) @map("created_at")

  usedInPost BlogPost? @relation(fields: [usedInPostId], references: [id], onDelete: SetNull)

  @@index([keyword])
  @@index([category, cachedUntil])
  @@index([source, createdAt])
  @@map("trend_keywords")
}

model ApiQuota {
  id             String   @id @default(cuid())
  apiName        String   @map("api_name")
  date           DateTime
  callsUsed      Int      @default(0) @map("calls_used")
  callsLimit     Int      @default(8) @map("calls_limit")
  monthCallsUsed Int      @default(0) @map("month_calls_used")
  monthCallsLimit Int     @default(250) @map("month_calls_limit")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([apiName, date])
  @@index([apiName, date])
  @@map("api_quotas")
}

model Contato {
  id        String   @id @default(cuid())
  nome      String
  email     String
  telefone  String?
  assunto   String?
  origem    String   @default("site")
  status    String   @default("novo")
  mensagem  String
  lido      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([status])
  @@index([createdAt])
  @@map("contatos")
}

model EbookDownload {
  id        String   @id @default(cuid())
  nome      String
  email     String
  whatsapp  String?
  emailSeq  Int      @default(0)
  createdAt DateTime @default(now())

  @@map("ebook_downloads")
}

model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String   @map("password_hash")
  name         String   @default("Admin")
  email        String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("admin_users")
}

model Analise {
  id         String   @id @default(cuid())
  resumo     String
  dados      String
  totalPosts Int      @default(0)
  totalLeads Int      @default(0)
  createdAt  DateTime @default(now())

  @@map("analises")
}

model CampanhaGerada {
  id         String   @id @default(cuid())
  nome       String
  objetivo   String
  plataforma String
  dados      String
  createdAt  DateTime @default(now())

  @@map("campanhas_geradas")
}

model KnowledgeBase {
  id          String   @id @default(cuid())
  sourceUrl   String
  sourceTitle String?
  content     String   @db.Text
  category    String
  year        Int?
  fetchedAt   DateTime @default(now())
  expiresAt   DateTime
  isActive    Boolean  @default(true)

  @@unique([sourceUrl, category])
  @@index([category, year, isActive])
  @@map("knowledge_base")
}

model KeywordHistory {
  id        String   @id @default(cuid())
  keyword   String
  cluster   String
  postId    String?
  usedAt    DateTime @default(now())
  coreTopic String?  @map("core_topic")

  @@index([usedAt])
  @@index([keyword])
  @@map("keyword_history")
}

model AnalyticsEvent {
  id          String   @id @default(cuid())
  sessionId   String
  type        String
  page        String
  referrer    String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?
  utmTerm     String?
  scrollDepth Int?
  timeOnPage  Int?
  element     String?
  country     String?
  region      String?
  city        String?
  device      String?
  browser     String?
  os          String?
  screenW     Int?
  screenH     Int?
  createdAt   DateTime @default(now())

  @@index([type])
  @@index([page])
  @@index([createdAt])
  @@index([sessionId])
  @@map("analytics_events")
}

model AutomationRun {
  id             String   @id @default(cuid())
  automationKey  String   @map("automation_key")
  trigger        String   @default("cron")
  status         String   @default("started")
  startedAt      DateTime @default(now()) @map("started_at")
  finishedAt     DateTime? @map("finished_at")
  durationMs     Int?     @map("duration_ms")
  generatedCount Int      @default(0) @map("generated_count")
  publishedCount Int      @default(0) @map("published_count")
  retainedCount  Int      @default(0) @map("retained_count")
  errorCount     Int      @default(0) @map("error_count")
  metadataJson   String   @default("{}") @map("metadata_json")

  @@index([automationKey, startedAt])
  @@index([status, startedAt])
  @@map("automation_runs")
}

// ─── MÓDULO AFILIADOS MERCADO PAGO ────────────────────────────────────────────

model AffiliatePage {
  id            String    @id @default(cuid())
  slug          String    @unique
  path          String    @unique
  title         String
  pageType      String    @default("artigo") @map("page_type")
  status        String    @default("publicado")
  indexable     Boolean   @default(true)
  inSitemap     Boolean   @default(true) @map("in_sitemap")
  allowRelated  Boolean   @default(true) @map("allow_related")
  metaTitle     String?   @map("meta_title")
  metaDesc      String?   @map("meta_desc")
  targetKeyword String?   @map("target_keyword")
  mainProduct   String?   @map("main_product")
  mainCta       String?   @map("main_cta")
  notes         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([status])
  @@index([pageType])
  @@map("affiliate_pages")
}

model AffiliateLink {
  id          String    @id @default(cuid())
  product     String    @unique
  label       String
  url         String
  buttonText  String    @default("Ver condições") @map("button_text")
  description String?
  active      Boolean   @default(true)
  priority    Int       @default(0)
  clickCount  Int       @default(0) @map("click_count")
  lastClickAt DateTime? @map("last_click_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("affiliate_links")
}

model AffiliateCta {
  id             String   @id @default(cuid())
  internalName   String   @map("internal_name")
  buttonText     String   @map("button_text")
  description    String?
  product        String?
  destinationUrl String   @map("destination_url")
  active         Boolean  @default(true)
  variant        String   @default("inline")
  position       String   @default("meio")
  impressions    Int      @default(0)
  clicks         Int      @default(0)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("affiliate_ctas")
}

model AffiliateSearchConsole {
  id            String   @id @default(cuid())
  pagePath      String   @map("page_path")
  targetKeyword String?  @map("target_keyword")
  impressions   Int      @default(0)
  clicks        Int      @default(0)
  ctr           Float    @default(0)
  avgPosition   Float    @default(0) @map("avg_position")
  lastUpdated   DateTime @default(now()) @map("last_updated")
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([pagePath, targetKeyword])
  @@index([pagePath])
  @@map("affiliate_search_console")
}
